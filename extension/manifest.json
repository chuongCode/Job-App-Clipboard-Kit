{
  "manifest_version": 3,
  "name": "Job App Clipboard Kit",
  "version": "0.1.5",
  "description": "Quickly copy frequently used job application information.",
  "browser_specific_settings": {
    "gecko": {
      "id": "job-app-clipboard-kit@extensions.local",
      "update_url": "https://chuongcode.github.io/Job-App-Clipboard-Kit/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Job App Clipboard Kit",
    "default_icon": {
      "16": "icons/robot-v4-16.png",
      "32": "icons/robot-v4-32.png",
      "48": "icons/robot-v4-48.png",
      "96": "icons/robot-v4-96.png"
    }
  },
  "icons": {
    "16": "icons/robot-v4-16.png",
    "32": "icons/robot-v4-32.png",
    "48": "icons/robot-v4-48.png",
    "96": "icons/robot-v4-96.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
